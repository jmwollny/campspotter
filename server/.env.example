# Copy to server/.env. Everything is optional; defaults shown.

# --- LLM -------------------------------------------------------------------
# Local Ollama is used when enabled; otherwise Gemini if GEMINI_API_KEY is set;
# otherwise sites are scored with a built-in heuristic.
LOCAL_LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gemma4:e2b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=120
# How many of the nearest sites are enriched (roads/water) and sent to the LLM.
LLM_CANDIDATE_POOL_SIZE=10

# --- Scoring ---------------------------------------------------------------
# Red flags (buildings, barriers...) within this many metres of a site are reported.
MIN_DISTANCE_TO_HAZARD=150

# --- Overpass (OpenStreetMap) ------------------------------------------------
# Comma-separated mirrors, tried in order.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter
OVERPASS_CONNECT_TIMEOUT_S=10
OVERPASS_READ_TIMEOUT_S=100
# The most one request to one mirror may take in total (the read timeout only limits
# silences; a busy server can keep a connection alive by trickling data for hours).
OVERPASS_TOTAL_TIMEOUT_S=150
# The public servers are often "at capacity": retry the mirror list this many
# times, waiting OVERPASS_BACKOFF_S, then 2x, 4x... between rounds.
OVERPASS_MAX_ROUNDS=3
OVERPASS_BACKOFF_S=3
OVERPASS_RETRY_MIN_DELAY_S=0.5
OVERPASS_RETRY_MAX_DELAY_S=1.5

# --- Server ----------------------------------------------------------------
# HOST=127.0.0.1   (use 0.0.0.0 to allow other devices on your network)
# PORT=8000
# DEBUG also appends every Overpass query and response to server/overpass_query_log.txt
LOG_LEVEL=INFO
